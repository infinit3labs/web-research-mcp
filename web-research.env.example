# web-research MCP — optional API keys
# Copy this file to web-research.env and fill in any keys you have.
# The server works with zero keys; you just lose the real web index fallback.
# (Wikipedia, arXiv, Hacker News, Stack Exchange, Crossref, and Jina fetching all work keyless.)

# --- Best general web search (used by search_web) ---
# Brave Search: https://brave.com/search/api/ — 2000 free queries/month
# BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxx

# Tavily: https://tavily.com — 1000 free queries/month, research-optimized
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxx

# --- Higher rate limits on fetch_url ---
# Jina Reader: https://jina.ai/reader — works keyless at 20 RPM, 1M tokens/month free
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxx

# --- Provider request resilience (optional; defaults are safe for local use) ---
# WEB_RESEARCH_TIMEOUT_SECONDS=30
# Override a single provider when it needs a different budget:
# WEB_RESEARCH_TIMEOUT_WIKIPEDIA_SECONDS=15
# WEB_RESEARCH_TIMEOUT_JINA_SECONDS=45
# WEB_RESEARCH_MAX_RETRIES=2
# WEB_RESEARCH_RETRY_BACKOFF_SECONDS=0.25
# WEB_RESEARCH_MAX_BACKOFF_SECONDS=5
